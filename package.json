{
  "name": "inko-pdf-sdk",
  "version": "1.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinabin/inko-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sinabin/inko-sdk/issues"
  },
  "homepage": "https://nexth.co.kr/inko",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-oss-boundary.mjs",
    "build:pkg": "node scripts/build-pkg.mjs",
    "prepack": "node scripts/block-root-package.mjs",
    "test:oss-boundary": "node scripts/check-oss-boundary.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts tests/e2e/sdk-roundtrip.spec.ts tests/e2e/apply-config.spec.ts tests/e2e/version-history-mode.spec.ts",
    "test:e2e:ui": "playwright test tests/e2e/smoke.spec.ts tests/e2e/sdk-roundtrip.spec.ts tests/e2e/apply-config.spec.ts tests/e2e/version-history-mode.spec.ts --ui",
    "test:release-package": "node scripts/release/verify-release-package.mjs release",
    "test:release-install": "node tests/release/verify-installed-tarball.mjs --expect-public"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/paper": "^0.11.14",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624"
  }
}
